<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BedrockPackStudio.MainPage"
             BackgroundColor="#1E1E1E">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Bedrock Pack Studio Mobile" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   HorizontalOptions="Center" />

            <Button Text="Paket Oluştur ve Minecraft'a Aktar" 
                    Clicked="OnBuildAndExportClicked" 
                    BackgroundColor="#2D8CFF" 
                    TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BedrockPackStudio.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#101114"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- TOP BAR -->
        <Grid
            Grid.Row="0"
            HeightRequest="62"
            Padding="14,0"
            BackgroundColor="#181A1F"
            ColumnDefinitions="Auto,*,Auto">

            <Button
                Grid.Column="0"
                Text="☰"
                FontSize="25"
                TextColor="White"
                BackgroundColor="Transparent"
                Clicked="OnMenuClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                Spacing="0">

                <Label
                    Text="Bedrock Pack Studio"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Minecraft Bedrock Editor"
                    FontSize="11"
                    TextColor="#858A94" />

            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="⋮"
                FontSize="25"
                TextColor="White"
                BackgroundColor="Transparent"
                Clicked="OnMoreClicked" />

        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollView
            Grid.Row="1"
            x:Name="MainScroll">

            <VerticalStackLayout
                Padding="16"
                Spacing="14">

                <!-- PACK CARD -->
                <Border
                    Stroke="#2C3038"
                    StrokeThickness="1"
                    BackgroundColor="#191B20"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="70,*">

                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            BackgroundColor="#252A32">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                Text="📦"
                                FontSize="30"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalOptions="Center">

                            <Label
                                Text="Test Pack"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Resource Pack"
                                FontSize="13"
                                TextColor="#858A94" />

                            <Label
                                x:Name="PackStatusLabel"
                                Text="Yeni proje"
                                FontSize="12"
                                TextColor="#4EC9B0" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- ACTIONS -->
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="10">

                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="📂  Dosyalar"
                        HeightRequest="62"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Clicked="OnFilesClicked" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="🖼️  Texture"
                        HeightRequest="62"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Clicked="OnTextureClicked" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="&lt;/&gt;  Kod Editörü"
                        HeightRequest="62"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Clicked="OnCodeClicked" />

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="📦  .MCPACK"
                        HeightRequest="62"
                        BackgroundColor="#176B43"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        Clicked="OnBuildClicked" />

                </Grid>

                <!-- PROJECT FILES -->
                <Label
                    Text="Proje Dosyaları"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"
                    Margin="0,10,0,0" />

                <Border
                    BackgroundColor="#191B20"
                    Stroke="#2C3038"
                    Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout>

                        <Grid
                            Padding="15"
                            ColumnDefinitions="32,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="📁"
                                FontSize="20" />

                            <Label
                                Grid.Column="1"
                                Text="textures"
                                TextColor="White"
                                FontSize="15"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="›"
                                TextColor="#777D87"
                                FontSize="25" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#292D34" />

                        <Grid
                            Padding="15"
                            ColumnDefinitions="32,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="📄"
                                FontSize="19" />

                            <Label
                                Grid.Column="1"
                                Text="manifest.json"
                                TextColor="White"
                                FontSize="15"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="›"
                                TextColor="#777D87"
                                FontSize="25" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- INFO -->
                <Border
                    BackgroundColor="#15171B"
                    Stroke="#252930"
                    Padding="15">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Label
                        Text="💡 Bir texture seçerek piksel düzenleyiciyi açabilirsin. JSON dosyaları kod editöründe açılır."
                        TextColor="#9298A3"
                        FontSize="13" />

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- BOTTOM NAVIGATION -->
        <Grid
            Grid.Row="2"
            HeightRequest="68"
            BackgroundColor="#181A1F"
            ColumnDefinitions="*,*,*">

            <Button
                Grid.Column="0"
                Text="🏠&#x0a;Ana Sayfa"
                FontSize="11"
                TextColor="#4EC9B0"
                BackgroundColor="Transparent"
                Clicked="OnHomeClicked" />

            <Button
                Grid.Column="1"
                Text="📦&#x0a;Pack"
                FontSize="11"
                TextColor="#858A94"
                BackgroundColor="Transparent"
                Clicked="OnPackClicked" />

            <Button
                Grid.Column="2"
                Text="⚙️&#x0a;Ayarlar"
                FontSize="11"
                TextColor="#858A94"
                BackgroundColor="Transparent"
                Clicked="OnSettingsClicked" />

        </Grid>

    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BedrockPackStudio.TextureEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0D0F12"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid
            Grid.Row="0"
            HeightRequest="62"
            Padding="8,0"
            BackgroundColor="#17191E"
            ColumnDefinitions="Auto,*,Auto">

            <Button
                Text="‹"
                FontSize="32"
                WidthRequest="52"
                TextColor="White"
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"/>

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center">

                <Label
                    x:Name="FileNameLabel"
                    Text="Texture Editor"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Pixel Editor"
                    FontSize="10"
                    TextColor="#858A94"/>
            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="💾"
                FontSize="21"
                WidthRequest="52"
                TextColor="White"
                BackgroundColor="Transparent"
                Clicked="OnSaveClicked"/>
        </Grid>

        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Padding="14"
                Spacing="14">

                <HorizontalStackLayout
                    Spacing="8">

                    <Button
                        Text="↶"
                        FontSize="21"
                        WidthRequest="52"
                        HeightRequest="48"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        Clicked="OnUndoClicked"/>

                    <Button
                        Text="↷"
                        FontSize="21"
                        WidthRequest="52"
                        HeightRequest="48"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        Clicked="OnRedoClicked"/>

                    <Button
                        Text="⊞ Grid"
                        HeightRequest="48"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        Clicked="OnGridClicked"/>

                </HorizontalStackLayout>

                <Border
                    BackgroundColor="#25282E"
                    Stroke="#3A3F48"
                    Padding="10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Grid
                        HeightRequest="320">

                        <GraphicsView
                            x:Name="PixelCanvas"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>

                    </Grid>
                </Border>

                <Label
                    Text="Araçlar"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Grid
                    ColumnDefinitions="*,*,*,*,*"
                    ColumnSpacing="6">

                    <Button
                        Grid.Column="0"
                        Text="✏️"
                        HeightRequest="54"
                        BackgroundColor="#176B43"
                        TextColor="White"
                        Clicked="OnPenClicked"/>

                    <Button
                        Grid.Column="1"
                        Text="🧹"
                        HeightRequest="54"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        Clicked="OnEraserClicked"/>

                    <Button
                        Grid.Column="2"
                        Text="🪣"
                        HeightRequest="54"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        Clicked="OnFillClicked"/>

                    <Button
                        Grid.Column="3"
                        Text="💧"
                        HeightRequest="54"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        Clicked="OnPickerClicked"/>

                    <Button
                        Grid.Column="4"
                        Text="🎨"
                        HeightRequest="54"
                        BackgroundColor="#20242B"
                        TextColor="White"
                        Clicked="OnColorClicked"/>

                </Grid>

                <Border
                    BackgroundColor="#191C21"
                    Stroke="#2C3038"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="Renk"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White"/>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">

                            <Entry
                                x:Name="ColorEntry"
                                Text="#FFFFFF"
                                Placeholder="#RRGGBB"
                                TextColor="White"
                                PlaceholderColor="#777D87"
                                BackgroundColor="#25282E"/>

                            <Button
                                Grid.Column="1"
                                Text="Uygula"
                                BackgroundColor="#176B43"
                                TextColor="White"
                                Clicked="OnApplyColorClicked"/>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.Row="2"
            HeightRequest="62"
            BackgroundColor="#17191E"
            ColumnDefinitions="*,*,*">

            <Button
                Text="16×16"
                TextColor="#4EC9B0"
                BackgroundColor="Transparent"/>

            <Button
                Grid.Column="1"
                Text="Pixel"
                TextColor="#858A94"
                BackgroundColor="Transparent"/>

            <Button
                Grid.Column="2"
                Text="PNG"
                TextColor="#858A94"
                BackgroundColor="Transparent"/>

        </Grid>

    </Grid>

</ContentPage>

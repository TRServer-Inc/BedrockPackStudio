<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- hem windows hem android hedefleri eklendi -->
		<TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>BedrockPackStudio</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<!-- resmindeki mevcut ayarlar -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- android uygulama kimlik bilgileri -->
		<ApplicationId>com.trserverinc.bedrockpackstudio</ApplicationId>
		<ApplicationTitle>Bedrock Pack Studio</ApplicationTitle>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.3" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.3" />
	</ItemGroup>

</Project>

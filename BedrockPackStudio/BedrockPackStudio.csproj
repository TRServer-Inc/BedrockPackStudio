<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- hem windows hem android hedefleri eklendi -->
		<TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>BedrockPackStudio</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<!-- resmindeki mevcut ayarlar -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- android uygulama kimlik ve launcher bilgileri -->
		<ApplicationId>com.trserverinc.bedrockpackstudio</ApplicationId>
		<ApplicationTitle>Bedrock Pack Studio</ApplicationTitle>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		
		<!-- launcher simgesi ve manifest eşleşmesi -->
		<AndroidApplication>true</AndroidApplication>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
	</ItemGroup>

	<!-- android derlemesinde winforms dosyalarını hariç tut -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net9.0-android'">
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net9.0-windows10.0.19041.0'">
		<Compile Remove="Form1.cs" />
		<Compile Remove="Form1.Designer.cs" />
		<Compile Remove="Form1.resx" />
	</ItemGroup>

</Project>

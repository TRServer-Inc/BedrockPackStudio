<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BedrockPackStudio.CodeEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0D0F12"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid
            Grid.Row="0"
            HeightRequest="62"
            Padding="8,0"
            BackgroundColor="#17191E"
            ColumnDefinitions="Auto,*,Auto">

            <Button
                Text="‹"
                FontSize="32"
                WidthRequest="52"
                TextColor="White"
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"/>

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center">

                <Label
                    x:Name="FileNameLabel"
                    Text="Kod Editörü"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="JSON / TXT / LANG"
                    FontSize="10"
                    TextColor="#858A94"/>
            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Text="💾"
                FontSize="21"
                WidthRequest="52"
                TextColor="White"
                BackgroundColor="Transparent"
                Clicked="OnSaveClicked"/>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="38,*"
            BackgroundColor="#0D0F12">

            <ScrollView
                Grid.Column="0"
                BackgroundColor="#15171B">

                <Label
                    x:Name="LineNumbers"
                    Text="1"
                    TextColor="#626873"
                    FontFamily="monospace"
                    FontSize="12"
                    HorizontalTextAlignment="End"
                    Padding="6,12"/>
            </ScrollView>

            <Editor
                Grid.Column="1"
                x:Name="CodeEditor"
                TextColor="#D4D4D4"
                BackgroundColor="#0D0F12"
                FontFamily="monospace"
                FontSize="13"
                AutoSize="TextChanges"
                TextChanged="OnTextChanged"
                VerticalTextAlignment="Start"/>

        </Grid>

        <ScrollView
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalScrollBarVisibility="Never">

            <HorizontalStackLayout
                Padding="8"
                Spacing="8"
                BackgroundColor="#17191E">

                <Button
                    Text="↶"
                    FontSize="20"
                    WidthRequest="52"
                    BackgroundColor="#20242B"
                    TextColor="White"
                    Clicked="OnUndoClicked"/>

                <Button
                    Text="↷"
                    FontSize="20"
                    WidthRequest="52"
                    BackgroundColor="#20242B"
                    TextColor="White"
                    Clicked="OnRedoClicked"/>

                <Button
                    Text="{} Format"
                    BackgroundColor="#20242B"
                    TextColor="White"
                    Clicked="OnFormatClicked"/>

                <Button
                    Text="✓ JSON"
                    BackgroundColor="#176B43"
                    TextColor="White"
                    Clicked="OnValidateClicked"/>

            </HorizontalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
